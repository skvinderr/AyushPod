{
  "name": "medikiosk",
  "version": "1.0.0",
  "private": true,
  "description": "MediKiosk (AyushPod) Monorepo for SIH26047",
  "workspaces": [
    "client/patient",
    "client/doctor",
    "client/admin",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:patient": "npm run dev --workspace=patient",
    "dev:doctor": "npm run dev --workspace=doctor",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:all": "npm run dev:patient & npm run dev:doctor & npm run dev:admin & npm run dev:backend"
  }
}
